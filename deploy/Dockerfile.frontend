FROM node:20-alpine AS runtime
WORKDIR /app
RUN addgroup -S wfs && adduser -S wfs -G wfs
USER wfs
ENV NODE_ENV=production
ENV NEXT_PUBLIC_WFS_CMMS_API_BASE=/v1
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget -qO- http://127.0.0.1:3000/ || exit 1
CMD ["node", "-e", "console.info('{\"level\":\"info\",\"message\":\"final release preparation\",\"event\":\"container\",\"detail\":\"frontend\"}')"]
