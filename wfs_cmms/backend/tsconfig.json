{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "module-loader.ts", "runtime-context.ts", "runtime-dependencies.ts", "router-wiring.ts", "src/core/dto/**/*.ts", "modules/**/*.ts"]
}
